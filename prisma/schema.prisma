// Prisma schema for Belajar Ads
// Default SQLite for zero-config local development, fully relational & PostgreSQL compatible for production deployment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // Hashed with bcrypt
  role      String   @default("ADMIN") // SUPERADMIN, ADMIN, EDITOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id            String    @id @default(cuid())
  slug          String    @unique
  titleId       String
  titleEn       String
  excerptId     String
  excerptEn     String
  contentId     String    // Rich markdown/HTML content in ID
  contentEn     String    // Rich markdown/HTML content in EN
  featuredImage String?
  category      String    // Fundamental, Campaign, Analytics, Creative, Scaling, etc.
  tags          String?   // Comma separated
  author        String    @default("Belajar Ads Team")
  readingTime   String    @default("5 min read")
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  metaTitleId   String?
  metaTitleEn   String?
  metaDescId    String?
  metaDescEn    String?
  ogImage       String?
  views         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model ArticleCategory {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameId        String
  nameEn        String
  descriptionId String?
  descriptionEn String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Program {
  id                 String   @id @default(cuid())
  slug               String   @unique
  nameId             String
  nameEn             String
  category           String   // ECOURSE, TRAINING, WORKSHOP, PRIVATE_MENTORING, COMPANY_TRAINING
  topic              String   @default("Meta Ads") // Meta Ads, Google Ads, TikTok Ads, etc.
  descriptionId      String
  descriptionEn      String
  overviewId         String?
  overviewEn         String?
  level              String   @default("All Levels") // Beginner, Intermediate, Advanced, All Levels
  format             String   @default("Online") // Online, Offline, Hybrid
  isOnline           Boolean  @default(true)
  duration           String?  // e.g. "4 Weeks", "2 Days Intensive", "Self-paced"
  price              String?  // Optional display price or range
  instructor         String?  @default("Belajar Ads Mentor")
  startDate          String?
  registrationStatus String   @default("AVAILABLE") // AVAILABLE, COMING_SOON, SOLD_OUT, CLOSED, COMPLETED
  featuredImage      String?
  ctaTextId          String?  @default("Daftar Sekarang")
  ctaTextEn          String?  @default("Register Now")
  registrationUrl    String?  // External URL or empty (uses default fallback)
  metaTitleId        String?
  metaTitleEn        String?
  metaDescId         String?
  metaDescEn         String?
  isFeatured         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([slug])
  @@index([category])
}

model Event {
  id                 String   @id @default(cuid())
  slug               String   @unique
  titleId            String
  titleEn            String
  category           String   @default("WORKSHOP") // WORKSHOP, MEETUP, TRAINING, WEBINAR, ADS_CLINIC, COMMUNITY_EVENT
  date               String   // Formatted display date, e.g. "2026-10-15"
  time               String?  // e.g. "19:30 - 21:30 WIB"
  location           String   @default("Online via Zoom")
  isOnline           Boolean  @default(true)
  speaker            String   @default("Belajar Ads Practitioner")
  speakerRoleId      String?
  speakerRoleEn      String?
  speakerImage       String?
  descriptionId      String
  descriptionEn      String
  agendaId           String?  // JSON string or markdown
  agendaEn           String?
  whatYouWillLearnId String?  // JSON string or markdown bullet points
  whatYouWillLearnEn String?
  whoShouldAttendId  String?
  whoShouldAttendEn  String?
  price              String?  @default("Free / Community")
  registrationUrl    String?  // External registration URL
  capacity           String?
  status             String   @default("UPCOMING") // UPCOMING, OPEN, SOLD_OUT, CLOSED, COMPLETED
  eventImage         String?
  gallery            String?  // JSON array of image URLs
  metaTitleId        String?
  metaTitleEn        String?
  metaDescId         String?
  metaDescEn         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model Resource {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleId       String
  titleEn       String
  type          String   // TUTORIAL, CASE_STUDY, ADS_BREAKDOWN, FREE_RESOURCE
  category      String?  @default("Meta Ads")
  excerptId     String
  excerptEn     String
  contentId     String   // Markdown / analysis text in ID
  contentEn     String   // Markdown / analysis text in EN
  downloadUrl   String?  // For templates, guides, checklists
  featuredImage String?
  isPublished   Boolean  @default(true)
  metaTitleId   String?
  metaTitleEn   String?
  metaDescId    String?
  metaDescEn    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([type])
}

model Mentor {
  id          String   @id @default(cuid())
  name        String
  roleId      String
  roleEn      String
  photo       String?
  bioId       String
  bioEn       String
  expertiseId String
  expertiseEn String
  socialUrl   String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String
  company        String?
  participants   String?  // For corporate training inquiries
  trainingNeeds  String?
  preferredDate  String?
  isOnline       Boolean? @default(true)
  source         String   @default("CONTACT_FORM") // CONTACT_FORM, BUSINESS_INQUIRY, EVENT_REGISTRATION, COMMUNITY_CTA, PROGRAM_CTA
  message        String?
  status         String   @default("NEW") // NEW, CONTACTED, QUALIFIED, CLOSED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([source])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageContent {
  id         String   @id @default(cuid())
  pageKey    String   // home, programs, events, community, for_business, resources, about, contact
  sectionKey String   // hero, pillars, cta, etc.
  contentId  String   // JSON string of Indonesian content for this section
  contentEn  String   // JSON string of English content for this section
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([pageKey, sectionKey])
  @@index([pageKey])
}

model PageVisibility {
  id        String   @id @default(cuid())
  pageKey   String   @unique // programs, events, community, for_business, resources, about, contact, articles, tutorials, case_studies, ads_breakdown, free_resources
  name      String   // Display label
  route     String   // Target route
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageKey])
}
